# Environment Configuration for JobFlow AI

APP_NAME="JobFlow AI"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Authentication & Public Deployment Security
# Enable login gate before accessing the application (recommended for public deployments)
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=your_secure_password_here
SECRET_KEY=generate_a_random_32_char_secret_key_for_production


# LLM Configuration (OpenAI, Anthropic, Gemini, Groq, DeepSeek, or any OpenAI-Compatible Endpoint)
# Model name examples:
# - OpenAI: gpt-4o-mini, gpt-4o
# - OpenRouter: openai/gpt-4o-mini, deepseek/deepseek-chat, anthropic/claude-3.5-sonnet
# - Ollama / Local: llama3, qwen2.5:14b, mistral
# - Custom OpenAI-compatible proxy: openai/<model-name>
LLM_MODEL=gpt-4o-mini

# OpenAI / OpenAI-Compatible Endpoint Settings:
OPENAI_API_KEY=your_api_key_or_placeholder
# Custom Endpoint URL (leave empty for standard OpenAI, or set e.g. https://openrouter.ai/api/v1, http://host.docker.internal:11434/v1)
OPENAI_API_BASE=

# Other direct provider keys (optional):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///data/jobflow.db

# Redis
REDIS_URL=redis://localhost:6379/0
