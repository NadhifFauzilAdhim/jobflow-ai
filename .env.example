# Environment Configuration for JobFlow AI

APP_NAME="JobFlow AI"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Optional: Add your API keys for advanced LLM tailoring
# (If omitted, JobFlow AI automatically uses its built-in heuristic ATS optimization engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
LLM_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///data/jobflow.db

# Redis
REDIS_URL=redis://localhost:6379/0
